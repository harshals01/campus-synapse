# ── Vector Store ──────────────────────────────────────────────────────────────
# Leave QDRANT_URL blank to use local-file mode (recommended for single-laptop setup).
# Set to a remote URL only if running a Qdrant server.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
INDEX_NAME=campus_synapse

# ── Groq LLM ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b

# ── RAG Thresholds ────────────────────────────────────────────────────────────
# Minimum dense-search cosine similarity (0.0–1.0) to answer; below this, abstain.
SIMILARITY_THRESHOLD=0.35
MAX_CONTEXT_DOCS=20
CHAT_HISTORY_WINDOW=6

# ── Ingestion ─────────────────────────────────────────────────────────────────
INGEST_BATCH_SIZE=32
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_USER=10
FILE_STORAGE_PATH=./data/files

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<generate-and-paste-here>
JWT_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/campus.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated frontend origins. Leave blank to default to localhost:5173.
ALLOWED_ORIGINS=
